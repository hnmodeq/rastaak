# ============================================================
# RASTAAK — environment variables
# Copy to .env.local for local dev, and set the same values in
# Vercel → Project → Settings → Environment Variables.
# ============================================================

# --- Supabase (object storage for images) ---
# Create a project at https://supabase.com, then create a public bucket
# (e.g. "rastaak-assets") and upload public/assets/* into it:
#   pnpm assets:upload
#
# When NEXT_PUBLIC_SUPABASE_URL + NEXT_PUBLIC_SUPABASE_BUCKET are set, images
# are served from the Supabase bucket. If they are unset, the site falls back
# to the local /public/assets files (still deploys & works on Vercel).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_BUCKET=rastaak-assets
# Only needed by scripts/upload-assets-to-supabase.mjs (server-side, never public):
SUPABASE_SERVICE_ROLE_KEY=

# --- Neon (Postgres database) ---
# Create a serverless Postgres database at https://neon.tech, copy the
# pooled connection string. Required only for the /api/contact endpoint
# (the landing page itself works without it).
DATABASE_URL=
